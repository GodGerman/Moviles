<?xml version="1.0" encoding="utf-8"?>
<!-- 
     ==========================================================================
     Archivo: activity_maps.xml
     Propósito: Interfaz de la utilidad de selección de geolocalización.
     ==========================================================================
-->
<!--
     ConstraintLayout: Contenedor raíz óptimo para mantener la pantalla plana (flat hierarchy).
     Aquí el mapa ocupará todo el espacio disponible menos el fondo destinado al botón.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
         fragment: Componente incrustado del SDK de Google Play Services.
         Al usar "SupportMapFragment", el SDK automáticamente renderiza la cuadrícula de mapas de Google 
         y se encarga del manejo pesado de memoria a través de OpenGL.
         Las constraints (constraintTop, constraintBottom) le dictan que llene el espacio superior hasta topar con el botón.
    -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm_location"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
         MaterialButton: Botón adherido a la parte inferior de la pantalla.
         Es la llamada a la acción (CTA) para regresar las coordenadas a la pantalla anterior.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_location"
        style="@style/Widget.Proyecto.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:text="Confirmar Ubicación"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
