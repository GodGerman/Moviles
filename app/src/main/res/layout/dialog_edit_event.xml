<?xml version="1.0" encoding="utf-8"?>
<!-- 
     ==========================================================================
     Archivo: dialog_edit_event.xml
     Propósito: Diseño del diálogo de edición de eventos.
     Este layout flota sobre la interfaz principal permitiendo alterar datos 
     o borrar un evento seleccionado.
     ==========================================================================
-->
<!--
    ScrollView: Permite desplazamiento vertical de sus elementos hijos.
    Esto es crítico en formularios largos o dispositivos pequeños para asegurar
    que el usuario pueda alcanzar los botones inferiores cuando el teclado
    virtual cubre la mitad de la pantalla.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface">

    <!-- 
         LinearLayout: Contenedor secuencial que apila los campos del formulario
         uno debajo del otro de manera estructurada. 
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/edit_event_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <!-- ═══════════ Categoría ═══════════ -->
        <TextView
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_category" />

        <!-- 
             MaterialCardView: Envuelve el Spinner para dotarlo de esquinas redondeadas 
             y un borde perimetral que cumple con las guías de Material Design. 
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_edit_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/categories_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Estatus ═══════════ -->
        <TextView
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_status" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_edit_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/status_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Fecha y Hora ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_date"
                style="@style/Widget.Proyecto.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_select_date"
                android:maxLines="1"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_calendar_small"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_time"
                style="@style/Widget.Proyecto.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_select_time"
                android:maxLines="1"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_time_small"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ═══════════ Descripción ═══════════ -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Proyecto.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════ Contacto ═══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_edit_contact"
            style="@style/Widget.Proyecto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_select_contact"
            app:icon="@drawable/ic_contact_small"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/et_edit_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- ═══════════ Ubicación (Lat, Lng) ═══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_edit_location"
            style="@style/Widget.Proyecto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_select_location"
            app:icon="@drawable/ic_location_small"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <TextView
                android:id="@+id/et_edit_lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=", "
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
                
            <TextView
                android:id="@+id/et_edit_lng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Previsualización de Mapa en Lite Mode -->
        <!-- 
             El "Lite Mode" de Google Maps renderiza un mapa estático como si fuera una imagen,
             ideal para diálogos rápidos porque consume muchísimo menos memoria que un mapa completo interactivo.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <com.google.android.gms.maps.MapView
                android:id="@+id/map_preview_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:liteMode="true"
                app:mapType="normal" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Recordatorio ═══════════ -->
        <TextView
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_reminder" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_edit_reminder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/reminders_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
