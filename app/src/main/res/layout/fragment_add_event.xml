<?xml version="1.0" encoding="utf-8"?>
<!-- 
     ==========================================================================
     Archivo: fragment_add_event.xml
     Propósito: Formulario principal para la creación de un nuevo evento.
     ==========================================================================
-->
<!-- 
     ScrollView: Contenedor vital para pantallas de captura de datos (formularios).
     Permite que el contenido se pueda desplazar verticalmente, asegurando que todos
     los campos sean accesibles incluso en dispositivos pequeños o cuando el teclado tapa la pantalla.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tv_add_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_event_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <!-- ═══════════ Sección: Categoría ═══════════ -->
        <TextView
            android:id="@+id/tv_label_category"
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_category" />

        <!-- 
             MaterialCardView: Utilizado aquí solo para dar un diseño bonito 
             con esquinas redondeadas al "Spinner" (lista desplegable nativa). 
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/categories_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Sección: Estatus ═══════════ -->
        <TextView
            android:id="@+id/tv_label_status"
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_status" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/status_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Sección: Fecha y Hora ═══════════ -->
        <!-- LinearLayout horizontal para colocar dos botones lado a lado. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- 
                 MaterialButton: Botones estilizados de Google. 
                 Se usan con 'layout_weight=1' para que ambos botones (Fecha y Hora) 
                 tomen equitativamente el 50% del ancho disponible cada uno.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_date"
                style="@style/Widget.Proyecto.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_select_date"
                app:icon="@drawable/ic_calendar_small"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_time"
                style="@style/Widget.Proyecto.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_select_time"
                app:icon="@drawable/ic_time_small"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ═══════════ Sección: Descripción ═══════════ -->
        <!-- 
             TextInputLayout: Componente avanzado de Material Design para cajas de texto.
             Brinda la funcionalidad visual de que el "Hint" (texto de fondo) 
             se anime y flote hacia arriba al momento de escribir. 
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            style="@style/Widget.Proyecto.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- TextInputEditText: El campo de entrada real para texto, hijo obligatorio del TextInputLayout -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════ Sección: Contacto ═══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_contact"
            style="@style/Widget.Proyecto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_select_contact"
            app:icon="@drawable/ic_contact_small"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/tv_selected_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- ═══════════ Sección: Ubicación ═══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_location"
            style="@style/Widget.Proyecto.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_select_location"
            app:icon="@drawable/ic_location_small"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/tv_selected_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- ═══════════ Sección: Recordatorio ═══════════ -->
        <TextView
            android:id="@+id/tv_label_reminder"
            style="@style/TextAppearance.Proyecto.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_reminder" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_reminder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/reminders_array"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Botón Guardar ═══════════ -->
        <!-- Botón primario de color lleno (Filled) para destacar la llamada a la acción principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Proyecto.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_save"
            android:textSize="16sp"
            app:icon="@drawable/ic_save_small"
            app:iconGravity="textStart" />

    </LinearLayout>

</ScrollView>
