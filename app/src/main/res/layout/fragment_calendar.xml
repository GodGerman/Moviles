<?xml version="1.0" encoding="utf-8"?>
<!-- 
     ==========================================================================
     Archivo: fragment_calendar.xml
     Propósito: Diseño de la pantalla del Calendario Interactivo.
     Combina una cuadrícula visual calculada (matriz de días) y una lista de 
     tareas resultantes para el día seleccionado.
     ==========================================================================
-->
<!-- 
     ConstraintLayout: Contenedor raíz bidimensional.
     Mantiene la estructura superior del calendario (cabecera y cuadrícula)
     junto con la lista dinámica de eventos del día en la parte inferior.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- ═══════════ Header: Navegación de Mes ═══════════ -->
    <!-- 
         ImageButton: selectableItemBackgroundBorderless
         Aplica el efecto nativo de ola expansiva (Ripple) de Android de forma circular,
         sin oscurecer un fondo rectangular, logrando un diseño muy limpio.
    -->
    <ImageButton
        android:id="@+id/btn_prev_month"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_prev_month"
        android:src="@drawable/ic_arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_month_year" />

    <!-- Título del Mes (ej. Junio 2026) -->
    <TextView
        android:id="@+id/tv_month_year"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/calendar_header"
        tools:text="Junio 2026"
        app:layout_constraintEnd_toStartOf="@id/btn_next_month"
        app:layout_constraintStart_toEndOf="@id/btn_prev_month"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_next_month"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_next_month"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_month_year" />

    <!-- ═══════════ Cabeceras de Días (D L M M J V S) ═══════════ -->
    <!-- 
         LinearLayout con layout_weight=1 en sus hijos: 
         Distribuye perfectamente las letras de los días a lo largo del eje X, 
         forzando a que cada elemento ocupe exactamente 1/7 del ancho total de pantalla.
    -->
    <LinearLayout
        android:id="@+id/ll_week_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_month_year">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_sun"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_mon"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_tue"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_wed"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_thu"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_fri"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_sat"
            android:textColor="@color/calendar_day_header"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════ Cuadrícula del Mes ═══════════ -->
    <!-- 
         RecyclerView (Grid): Aquí se inyectan dinámicamente las 35 o 42 celdas numéricas.
         Usa un GridLayoutManager desde el código Kotlin para partirlas en 7 columnas.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/ll_week_headers" />

    <!-- ═══════════ Título de Eventos ═══════════ -->
    <TextView
        android:id="@+id/tv_calendar_events_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/calendar_events_title"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_calendar_grid" />

    <!-- ═══════════ Lista de Eventos Inferior ═══════════ -->
    <!-- 
         RecyclerView (Lista): layout_height="0dp" junto con constraintBottom_toBottomOf="parent"
         provoca que la lista se estire ocupando absolutamente todo el espacio vertical restante 
         hasta chocar contra el borde de la pantalla o la Bottom Navigation Bar.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_calendar_events_title"
        tools:listitem="@layout/item_event" />

</androidx.constraintlayout.widget.ConstraintLayout>
