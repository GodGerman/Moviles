<?xml version="1.0" encoding="utf-8"?>
<!-- 
     ==========================================================================
     Archivo: fragment_home.xml
     Propósito: Diseño minimalista de la Pantalla Principal (Dashboard).
     Muestra simplemente el título de bienvenida y una lista infinita 
     con los próximos eventos registrados en la base de datos.
     ==========================================================================
-->
<!--
    ConstraintLayout: Se utiliza para anclar el título a la parte superior 
    y estirar la lista (RecyclerView) hasta el fondo.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingTop="16dp">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/tv_home_title"
        style="@style/TextAppearance.Proyecto.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/home_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 
         RecyclerView: Mecanismo de renderizado virtualizado altamente eficiente.
         Recicla las vistas a medida que salen de la pantalla para ahorrar memoria.
         - layout_height="0dp" + constraints en Top y Bottom dictan que ocupe el resto del layout.
         - tools:listitem="@layout/item_event": Instruye al IDE de Android Studio 
           renderizar una previsualización de datos falsos (Mocks) en el editor visual.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_title"
        tools:listitem="@layout/item_event" />

</androidx.constraintlayout.widget.ConstraintLayout>
