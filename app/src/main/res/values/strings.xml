    <!-- About Fragment -->
    <string name="about_title">Acerca del Proyecto</string>
    <string name="about_description">Organizador de Tareas es una aplicación robusta diseñada para la gestión eficiente de eventos. Destaca por su arquitectura limpia y ofrece características avanzadas como persistencia local, integración con Google Maps para ubicaciones de eventos, notificaciones automáticas y sincronización segura con respaldo en la nube a través de Google Drive.</string>
    <string name="about_developers_title">Creado por:</string>
